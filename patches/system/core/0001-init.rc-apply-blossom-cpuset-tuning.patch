From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Fri, 28 Feb 2025 20:28:24 +0700
Subject: [PATCH 1/2] init.rc: apply blossom cpuset tuning

Signed-off-by: fukiame <fukiame@proton.me>

diff --git a/rootdir/init.rc b/rootdir/init.rc
index eceb8f31a..205e83013 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -1466,24 +1466,20 @@ on property:persist.sys.power_mode_perf=0
     write /sys/devices/system/cpu/cpu6/cpufreq/schedutil/down_rate_limit_us 2000
   
 on property:persist.sys.power_mode_limit_cpus=1
-  write /dev/cpuset/top-app/cpus 0-3
-  write /dev/cpuset/dex2oat/cpus 0-1
-  write /dev/cpuset/camera-daemon/cpus 0-1
-  write /dev/cpuset/foreground/cpus 0-1
-  write /dev/cpuset/foreground_window/cpus 0-1
-  write /dev/cpuset/restricted/cpus 0-1
-  write /dev/cpuset/background/cpus 0-1
-  write /dev/cpuset/system-background/cpus 0-1
+    write /dev/cpuset/foreground/cpus 4-7
+    write /dev/cpuset/foreground/boost/cpus 4-7
+    write /dev/cpuset/background/cpus 4-7
+    write /dev/cpuset/system-background/cpus 4-5
+    write /dev/cpuset/top-app/cpus 4-7
+    write /dev/cpuset/restricted/cpus 4-5
 
 on property:persist.sys.power_mode_limit_cpus=0
-  write /dev/cpuset/top-app/cpus 0-7
-  write /dev/cpuset/dex2oat/cpus 0-3
-  write /dev/cpuset/camera-daemon/cpus 0-7
-  write /dev/cpuset/foreground/cpus 0-5
-  write /dev/cpuset/foreground_window/cpus 0-5
-  write /dev/cpuset/restricted/cpus 0-3
-  write /dev/cpuset/system-background/cpus 0-3
-  write /dev/cpuset/background/cpus 0-3
+    write /dev/cpuset/foreground/cpus 0-7
+    write /dev/cpuset/foreground/boost/cpus 0-7
+    write /dev/cpuset/background/cpus 1-3
+    write /dev/cpuset/system-background/cpus 4-7
+    write /dev/cpuset/top-app/cpus 0-7
+    write /dev/cpuset/restricted/cpus 2-7
   
 on property:persist.sys.battery_health_limit_charge=true
   write /sys/devices/platform/google,charger/charge_stop_level 80
